# Cloud sync (Supabase). Copy this file to `.env` for local dev and fill in the
# two values from your Supabase project: Dashboard → Project Settings → API.
#
# Both are safe to expose in the built site — Row-Level Security (see
# supabase/schema.sql) is what protects the data. Leave them blank/unset to run
# the app in its original local-only mode (no sign-in, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
